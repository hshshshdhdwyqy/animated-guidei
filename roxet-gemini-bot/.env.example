# Normally written for you by install.sh
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=123456789
BOT_NAME=RoXeT AI

# Optional. The Gemini API key is entered from the admin panel inside the bot
# (🛠 پنل مدیریت → 🔑 کلید API). Only set this if you want a fallback key.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional model overrides (can also be changed in the database)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash\n